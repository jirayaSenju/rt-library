# Environment Configuration Example
# Copy this file to .env or set variables in your environment for custom setups.

# Development Server
# NODE_ENV=development
# VITE_DEV_SERVER_URL=http://localhost:1420

# Custom Storage & Profile Locations (Defaults to OS standard user data paths)
# RT_LIBRARY_USER_DATA_DIR=/path/to/custom/userData
# SCRAPER_PROFILE_DIR=/path/to/custom/browser-profile
# DATA_DIR=/path/to/legacy/json/catalogs

# Diagnostics & Performance Telemetry
# RT_LIBRARY_PERF=0
# SCRAPER_DEBUG=false

