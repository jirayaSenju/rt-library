{
  "manifest_version": 3,
  "name": "RT Library Browser Companion",
  "version": "1.1.6",
  "description": "Fetch RuTracker forum pages for RT Library in your normal browser session.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.rutracker.org/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "RT Library Companion"
  }
}
