{
  "name": "rt-library",
  "private": true,
  "version": "1.0.0",
  "description": "Local desktop catalog manager for game metadata and personal library organization",
  "author": "RT-Library contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "env -u ELECTRON_RUN_AS_NODE playwright test",
    "desktop": "concurrently \"npm run dev\" \"electron .\"",
    "desktop:dev": "concurrently \"npm run dev\" \"electron .\"",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "desktop:build": "npm run build && npx electron-builder",
    "desktop:package": "npm run build && npx electron-builder --dir",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "scraper": "node scraper/runner.cjs",
    "scraper:login": "node scraper/runner.cjs --login",
    "scraper:headed": "node scraper/runner.cjs --headed",
    "scraper:headless:test": "node scraper/runner.cjs --headless --category xbox",
    "scraper:single-session": "node scraper/runner.cjs --single-session",
    "scraper:diagnose": "node scripts/diagnose-scraper.cjs",
    "scraper:diagnose-session": "node scripts/diagnose-session.cjs",
    "audit:images": "node scripts/audit-rutracker-images.cjs",
    "generate:icons": "node scripts/generate-app-icons.cjs",
    "package:verify": "node scripts/verify-package-runtime.cjs",
    "package:inspect": "node scripts/verify-package-runtime.cjs --inspect",
    "package:smoke": "node scripts/package-smoke.cjs",
    "package:linux": "npm run build && npx electron-builder --linux AppImage --publish never",
    "package:win": "npm run build && npx electron-builder --win nsis --publish never",
    "audit:licenses": "node scripts/audit-third-party-licenses.cjs",
    "benchmark": "node scripts/benchmark-runtime.cjs",
    "benchmark:electron": "node scripts/benchmark-electron.cjs",
    "benchmark:compare": "node scripts/compare-benchmarks.cjs",
    "release:check": "node scripts/check-publication-readiness.cjs",
    "release:validate": "node scripts/validate-release-version.cjs",
    "release:prepare": "node scripts/prepare-release.cjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-virtual": "^3.14.13",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.439.0",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.10",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.rtlibrary.app",
    "productName": "RT Library",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scraper/**/*",
      "scripts/console.js",
      "console.js",
      "build/icons/**/*",
      "THIRD_PARTY_LICENSES.txt",
      "LEGAL.md",
      "LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "RT-Library-${version}-linux-${arch}.${ext}",
      "category": "Game",
      "desktop": {
        "Name": "RT Library",
        "Comment": "Local Game & Catalog Viewer",
        "Categories": "Game;Utility;",
        "StartupWMClass": "rt-library",
        "Icon": "rt-library"
      }
    },
    "win": {
      "icon": "build/icons/rt-library.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "RT-Library-${version}-windows-${arch}-setup.${ext}"
    },
    "mac": {
      "icon": "build/icons/rt-library.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
